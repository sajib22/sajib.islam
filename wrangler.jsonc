{
  // ─────────────────────────────────────────────────────────────────────────
  //  Cloudflare Worker config for sajibislam.com
  //
  //  DO NOT EDIT THIS FILE without asking first. A wrong value here does not
  //  fail loudly in the browser — it fails the deploy, and the live site keeps
  //  serving the previous version while you wonder why your change never
  //  appeared. See CONTRIBUTING.md.
  // ─────────────────────────────────────────────────────────────────────────

  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker names allow lowercase letters, numbers and hyphens ONLY.
  // The repo is "sajib.islam", so Cloudflare will suggest a name containing a
  // dot, which is invalid. This is the correct name — leave it alone.
  "name": "sajibislam-com",

  // The Worker entry point. Today it does nothing but hand every request to
  // the static assets. Future features (contact form, RF calculators) branch
  // inside this file — see ROADMAP.md.
  "main": "src/index.js",

  "compatibility_date": "2025-09-01",

  "assets": {
    // The folder that gets served at the root of the site.
    // If this is wrong or missing, the deploy fails with:
    //   "Missing entry-point to Worker script or to assets directory"
    "directory": "./public",

    // Lets src/index.js reach the static files as env.ASSETS.
    // Costs nothing today; required by everything on the roadmap.
    "binding": "ASSETS",

    // Unknown URLs serve public/404.html with a 404 status.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
